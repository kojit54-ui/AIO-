{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/newsletter",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/cron/writing-reminder",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/indexing",
      "schedule": "15 22 * * *"
    },
    {
      "path": "/api/cron/billing-reminder",
      "schedule": "5 0 * * *"
    }
  ]
}
