# このファイルを .env.local にコピーして値を入れる（.env.local は Git に入らない）。
# 手順：docs/AI_SETUP.md
# キーが空のあいだは、AIを呼ばずにサンプルを返す（画面に「サンプル（AIは未接続）」と出る）。

# 文章：openai（既定）または anthropic
TEXT_PROVIDER=openai
# 普段の生成と仕上げのモデル（空なら提供元ごとの既定。OpenAI は両方 gpt-6.1-sol、Anthropic は claude-sonnet-5-5 / claude-opus-5-5）
AI_TEXT_MODEL=
AI_FINISH_MODEL=

# OpenAI（文章の既定。IMAGE_PROVIDER=openai のときは画像にも使う）
OPENAI_API_KEY=

# Anthropic（TEXT_PROVIDER=anthropic のときだけ使う）
ANTHROPIC_API_KEY=

# 画像：google（既定）または openai
IMAGE_PROVIDER=google
# suggest＝撮るとよい写真を提案するだけ（追加費用なし） / generate＝画像を生成する
IMAGE_MODE=suggest

# Google（Gemini API のキー）
GEMINI_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image

# OpenAI の画像（IMAGE_PROVIDER=openai のときだけ使う。キーは上の OPENAI_API_KEY）
OPENAI_IMAGE_MODEL=gpt-image-2.5
OPENAI_IMAGE_SIZE=1536x1024

# Supabase（docs/SUPABASE_SETUP.md）。URL と anon キーが空のあいだは、画面はブラウザ内の架空データで動く
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 管理用の鍵。サーバーだけで使う。NEXT_PUBLIC_ を付けない、ブラウザやGitに出さない
SUPABASE_SERVICE_ROLE_KEY=
# メールに載せるリンクの先頭（例：https://blog.example.jp）。空ならアクセスされたURLを使う
NEXT_PUBLIC_SITE_URL=
