# このファイルを .env.local にコピーして値を入れる（.env.local は Git に入らない）。
# 手順：docs/AI_SETUP.md
# キーが空のあいだは、AIを呼ばずにサンプルを返す（画面に「サンプル（AIは未接続）」と出る）。

# 役割ごとのAI（docs/DECISIONS.md 2026-10-23）。値は openai / anthropic / google
# 書き手（見出し案・本文・書き直し）の既定
TEXT_PROVIDER=openai
# 役割ごとに変えるとき（空なら 見出し案・本文＝TEXT_PROVIDER、点検＝anthropic、画像の提案＝google）
OUTLINE_PROVIDER=
BODY_PROVIDER=
REVIEW_PROVIDER=
IMAGE_IDEA_PROVIDER=
# 会社ごとのモデル（空なら既定。OpenAI は gpt-6.1-sol、Anthropic は claude-sonnet-5-5 / claude-opus-5-5、Google は gemini-4-argon）
OPENAI_TEXT_MODEL=
ANTHROPIC_TEXT_MODEL=
GEMINI_TEXT_MODEL=
# 以前からの設定。TEXT_PROVIDER の会社にだけ効く
AI_TEXT_MODEL=
AI_FINISH_MODEL=

# OpenAI（書き手。IMAGE_PROVIDER=openai のときは画像にも使う）
# AIに紹介されたかのチェックで使う、検索つきのモデル（空なら OPENAI_TEXT_MODEL か既定）
OPENAI_SEARCH_MODEL=
OPENAI_API_KEY=

# Search Console（つなぎ方A。docs/KEYWORD_TOOLS_SETUP.md の 3）。サービス用アカウントの JSON の client_email と private_key
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# しおり通信のメール（docs/DECISIONS.md 2026-11-03）。Google Workspace のアドレスと、そのアプリ パスワード
SMTP_USER=
SMTP_PASS=
# 送り主（空なら SMTP_USER）。SMTP_HOST・SMTP_PORT は空なら smtp.gmail.com・465
NEWSLETTER_FROM=
# 毎月1日の Cron の合言葉（Vercel が Authorization: Bearer で付ける）と、「受け取らない」のリンクの署名（空なら CRON_SECRET）
CRON_SECRET=
NEWSLETTER_SECRET=

# Anthropic（点検役。空なら書き手が点検する）
ANTHROPIC_API_KEY=

# 画像：google（既定）または openai
IMAGE_PROVIDER=google
# generate＝画面の「画像を作る」で画像を作る（既定、1枚約11円） / suggest＝撮るとよい写真を提案するだけ
IMAGE_MODE=generate

# Google（Gemini API のキー。画像の提案と画像の生成。空なら画像の提案は書き手が出す）
GEMINI_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image

# OpenAI の画像（IMAGE_PROVIDER=openai のときだけ使う。キーは上の OPENAI_API_KEY）
OPENAI_IMAGE_MODEL=gpt-image-2.5
OPENAI_IMAGE_SIZE=1536x1024

# ラッコキーワード（docs/KEYWORD_TOOLS_SETUP.md）。書く記事の提案の下調べに使う。空なら下調べなしでヒアリングだけから提案する
RAKKO_API_KEY=

# Supabase（docs/SUPABASE_SETUP.md）。URL と anon キーが空のあいだは、画面はブラウザ内の架空データで動く
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 管理用の鍵。サーバーだけで使う。NEXT_PUBLIC_ を付けない、ブラウザやGitに出さない
SUPABASE_SERVICE_ROLE_KEY=

# 30秒でためす（/try）で、ためした人の目印（IPなど）をハッシュするときの秘密。無ければ service role の鍵を使う。任意
TRIAL_SALT=
# メールに載せるリンクの先頭（例：https://blog.example.jp）。空ならアクセスされたURLを使う
NEXT_PUBLIC_SITE_URL=

# Googleでログイン（docs/SUPABASE_SETUP.md「Googleでログイン」）。Supabase で Google を有効にしてから on にする
NEXT_PUBLIC_GOOGLE_LOGIN=

# メールの6桁の番号でログイン（docs/SUPABASE_SETUP.md「メールの6桁の番号」）。メールの文面に {{ .Token }} を足してから on にする
NEXT_PUBLIC_LOGIN_CODE=

# 有料プラン（Stripe のカード払い。docs/BILLING_SETUP.md）。テストの鍵（sk_test_）なら本物のお金は動かない
STRIPE_SECRET_KEY=
# 本番の鍵で新規の申し込みを受け付けるとき on（田村さんが受付開始を決めてから）
SIGNUP_OPEN=
# 入口ページに「申し込む」のボタンを出すとき on
NEXT_PUBLIC_SIGNUP_OPEN=
