# このファイルを .env.local にコピーして値を入れる（.env.local は Git に入らない）。
# 手順：docs/AI_SETUP.md
# キーが空のあいだは、AIを呼ばずにサンプルを返す（画面に「サンプル（AIは未接続）」と出る）。

# 役割ごとのAI（docs/DECISIONS.md 2026-10-23）。値は openai / anthropic / google
# 書き手（見出し案・本文・書き直し）の既定
TEXT_PROVIDER=openai
# 役割ごとに変えるとき（空なら 見出し案・本文＝TEXT_PROVIDER、点検＝anthropic、画像の提案＝google）
OUTLINE_PROVIDER=
BODY_PROVIDER=
REVIEW_PROVIDER=
IMAGE_IDEA_PROVIDER=
# 会社ごとのモデル（空なら既定。OpenAI は gpt-6.1-sol、Anthropic は claude-sonnet-5-5 / claude-opus-5-5、Google は gemini-4-argon）
OPENAI_TEXT_MODEL=
ANTHROPIC_TEXT_MODEL=
GEMINI_TEXT_MODEL=
# 以前からの設定。TEXT_PROVIDER の会社にだけ効く
AI_TEXT_MODEL=
AI_FINISH_MODEL=

# OpenAI（書き手。IMAGE_PROVIDER=openai のときは画像にも使う）
OPENAI_API_KEY=

# Anthropic（点検役。空なら書き手が点検する）
ANTHROPIC_API_KEY=

# 画像：google（既定）または openai
IMAGE_PROVIDER=google
# generate＝画面の「画像を作る」で画像を作る（既定、1枚約11円） / suggest＝撮るとよい写真を提案するだけ
IMAGE_MODE=generate

# Google（Gemini API のキー。画像の提案と画像の生成。空なら画像の提案は書き手が出す）
GEMINI_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image

# OpenAI の画像（IMAGE_PROVIDER=openai のときだけ使う。キーは上の OPENAI_API_KEY）
OPENAI_IMAGE_MODEL=gpt-image-2.5
OPENAI_IMAGE_SIZE=1536x1024

# Supabase（docs/SUPABASE_SETUP.md）。URL と anon キーが空のあいだは、画面はブラウザ内の架空データで動く
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 管理用の鍵。サーバーだけで使う。NEXT_PUBLIC_ を付けない、ブラウザやGitに出さない
SUPABASE_SERVICE_ROLE_KEY=
# メールに載せるリンクの先頭（例：https://blog.example.jp）。空ならアクセスされたURLを使う
NEXT_PUBLIC_SITE_URL=
