# このファイルを .env.local にコピーして値を入れる（.env.local は Git に入らない）。
# 手順：docs/AI_SETUP.md
# キーが空のあいだは、AIを呼ばずにサンプルを返す（画面に「サンプル（AIは未接続）」と出る）。

# 文章：Anthropic（Claude）
ANTHROPIC_API_KEY=
# 普段の生成と仕上げのモデル（空なら既定）
AI_TEXT_MODEL=claude-sonnet-5-5
AI_FINISH_MODEL=claude-opus-5-5

# 画像：google（既定）または openai
IMAGE_PROVIDER=google
# suggest＝撮るとよい写真を提案するだけ（追加費用なし） / generate＝画像を生成する
IMAGE_MODE=suggest

# Google（Gemini API のキー）
GEMINI_API_KEY=
GOOGLE_IMAGE_MODEL=imagen-4.0-fast-generate-001

# OpenAI（IMAGE_PROVIDER=openai のときだけ使う）
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5
OPENAI_IMAGE_SIZE=1536x1024
